# Copy to .env.local for local development and fill in values.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Names only here.

# Public URL of the site, no trailing slash (e.g. https://toastandtribute.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (use test-mode keys sk_test_... until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" only after turning on Stripe Tax in the Stripe dashboard
STRIPE_AUTOMATIC_TAX=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. "Toast & Tribute <hello@yourdomain.com>"
EMAIL_FROM=
# Where new-order / questionnaire / contact / deletion notifications go
ADMIN_NOTIFY_EMAIL=

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting across all servers)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your Cal.com or Calendly booking page for the 15-minute intake call
BOOKING_URL=

# Random string (e.g. `openssl rand -hex 32`); Vercel Cron sends it to the purge job
CRON_SECRET=

# Optional: cookieless analytics via Plausible (your domain as registered there)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
